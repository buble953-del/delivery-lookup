import { NextRequest, NextResponse } from "next/server";

export function proxy(request: NextRequest) {
  const { pathname } = request.nextUrl;
  const adminCookie = request.cookies.get("admin_auth")?.value;
  const isAuthed = adminCookie === process.env.ADMIN_AUTH_TOKEN;

  const isAdminPage = pathname.startsWith("/admin");
  const isAdminLoginPage = pathname === "/admin/login";
  const isProtectedApi =
    pathname === "/api/upload" || pathname === "/api/test-admin";

  if (isProtectedApi && !isAuthed) {
    return NextResponse.json(
      { ok: false, error: "관리자 로그인이 필요합니다." },
      { status: 401 }
    );
  }

  if (isAdminPage) {
    if (isAdminLoginPage && isAuthed) {
      return NextResponse.redirect(new URL("/admin/upload", request.url));
    }

    if (!isAdminLoginPage && !isAuthed) {
      return NextResponse.redirect(new URL("/admin/login", request.url));
    }
  }

  return NextResponse.next();
}

export const config = {
  matcher: ["/admin/:path*", "/api/upload", "/api/test-admin"],
};